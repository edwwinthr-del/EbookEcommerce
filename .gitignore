# ---------------------------------------------------------------------------
# Secrets & credentials — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p12
*.pfx
/storage/*.key
/storage/oauth-*.key
secrets.json
*.secret
.stripe/

# ---------------------------------------------------------------------------
# Internal / agent working documents (local only)
# ---------------------------------------------------------------------------
CLAUDE.md
PROGRESS.md
ebook-store-agent-prompt.md
add-sample-data.php
/.claude/

# ---------------------------------------------------------------------------
# Local data: databases, uploaded e-books and covers, customer files
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite3
/database/*.sqlite*
/database/dumps/
*.sql
*.dump
/storage/app/private/
/storage/app/public/
!/storage/app/private/.gitignore
!/storage/app/public/.gitignore
/public/storage

# ---------------------------------------------------------------------------
# Dependencies & build output
# ---------------------------------------------------------------------------
/vendor
/node_modules
/public/build
/public/hot
/bootstrap/ssr
/bootstrap/cache/*.php

# ---------------------------------------------------------------------------
# Logs, caches & test artifacts
# ---------------------------------------------------------------------------
/storage/logs/*.log
/storage/pail
/storage/debugbar
*.log
npm-debug.log
yarn-error.log
pnpm-debug.log
.phpunit.result.cache
/.phpunit.cache
/coverage
.vite/

